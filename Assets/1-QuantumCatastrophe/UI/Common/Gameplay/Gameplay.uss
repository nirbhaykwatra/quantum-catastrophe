.health-orb-row {
    flex-direction: row;
    position: absolute;
    top: 16px;
    left: 16px;
}

.health-orb {
    width: 72px;
    height: 72px;
    margin-right: 6px;
    background-image: resource("UI/orb_empty");
    transition: scale 0.15s;
}

.health-orb.orb-filled {
    background-image: resource("UI/orb_filled");
}

.health-orb.orb-just-lost {
    scale: 1.3 1.3;
}

.pause-overlay {
    display: none;
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
}

.pause-panel {
    width: 320px;
    padding: 24px;
    align-items: center;
    background-image: resource("UI/pause_background");
}

.pause-button {
    background-image: resource("UI/button_normal");
    width: 240px;
    margin-top: 12px;
}
.pause-button:hover { background-image: resource("UI/button_hover"); }
.pause-button:active { background-image: resource("UI/button_pressed"); }

.death-screen {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0); /* overlay layer already handles the black */
    opacity: 0;
    display: none;
}

.death-title {
    font-size: 64px;
    color: rgb(200, 30, 30);
    -unity-font-style: bold;
    margin-bottom: 40px;
}

.death-button {
    background-image: resource("UI/button_normal");
    width: 200px;
    height: 48px;
    margin-top: 12px;
    font-size: 20px;
}
.death-button:hover { background-image: resource("UI/button_hover"); }
.death-button:active { background-image: resource("UI/button_pressed"); }

.win-screen {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0); /* overlay layer already handles the black */
    opacity: 0;
    display: none;
}

.win-title {
    font-size: 64px;
    color: rgb(200, 30, 30);
    -unity-font-style: bold;
    margin-bottom: 40px;
}

.win-button {
    background-image: resource("UI/button_normal");
    width: 200px;
    height: 48px;
    margin-top: 12px;
    font-size: 20px;
}
.win-button:hover { background-image: resource("UI/button_hover"); }
.win-button:active { background-image: resource("UI/button_pressed"); }
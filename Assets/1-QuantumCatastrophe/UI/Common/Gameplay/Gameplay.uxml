<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/1-QuantumCatastrophe/UI/Common/Gameplay/Gameplay.uss?fileID=7433441132597879392&amp;guid=2c0d646fc504bdc498d674cbbdcccc4c&amp;type=3#Gameplay"/>
    <ui:VisualElement name="health-orb-row" class="health-orb-row">
        <ui:VisualElement name="orb-0" class="health-orb"/>
        <ui:VisualElement name="orb-1" class="health-orb"/>
        <ui:VisualElement name="orb-2" class="health-orb"/>
        <ui:VisualElement name="orb-3" class="health-orb"/>
        <ui:VisualElement name="orb-4" class="health-orb"/>
    </ui:VisualElement>
    <ui:VisualElement name="pause-menu-overlay" class="pause-overlay">
        <ui:VisualElement name="pause-panel" class="pause-panel">
            <ui:Label text="Paused" class="pause-title"/>
            <ui:Button name="resume-button" text="Resume" class="pause-button"/>
            <ui:Button name="quit-button" text="Quit to Main Menu" class="pause-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

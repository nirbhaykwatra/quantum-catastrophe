.modal-panel {
    background-image: resource("UI/Tutorials/Background");
    -unity-slice-left: 6; -unity-slice-right: 6;
    -unity-slice-top: 6; -unity-slice-bottom: 6;
    width: 480px;
    min-height: 220px;
    max-height: 480px;
    padding: 24px;

    flex-direction: column;
    align-items: stretch;

    /* Enter/exit state — toggled via .modal-visible in TutorialModalController */
    opacity: 0;
    scale: 0.9 0.9;
    transition-property: opacity, scale;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.modal-panel.modal-visible {
    opacity: 1;
    scale: 1 1;
}
.tutorial-next-button {
    background-image: resource("UI/Tutorials/Button");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
}
.tutorial-next-button:hover { -unity-background-image-tint-color: red; }
.tutorial-next-button:active {  }

/* ---------- Highlight overlay ---------- */

.highlight-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    /* Dim-rects surround the spotlighted target, not cover it — the
       overlay itself must never block clicks on either the target
       underneath (world object or UI element) or anything else. */
    align-items: flex-start;
}

.dim-rect {
    background-color: rgba(0, 0, 0, 0.65);

    /* fade in alongside the modal rather than popping in instantly */
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.highlight-overlay, .dim-rect {
    pointer-events: none;
}
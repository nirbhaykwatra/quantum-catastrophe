        <ui:Label text="Tunneling Activator added to inventory!" name="notification-label" style="max-width: 100%; max-height: 100%; width: 71%; padding-top: 8px; padding-bottom: 8px; padding-right: 8px; padding-left: 8px; justify-content: flex-start; align-content: flex-start; -unity-text-align: middle-left; font-size: 29%; white-space: normal; letter-spacing: 0; text-shadow: 0 0 0 rgba(0, 0, 0, 0); -unity-text-outline-width: 0; text-overflow: ellipsis;"/>

.notification-container {
    overflow: hidden;
    -unity-background-scale-mode: scale-to-fit;
    position: absolute;
    padding-right: 5px;
    padding-top: 5px;
    right: 0;
}

.notification-item {
    background-image: resource("UI/Notifications/Background");
    -unity-slice-left: 9;
    -unity-slice-right: 9;
    -unity-slice-top: 9;
    -unity-slice-bottom: 9;
    flex-direction: row;
    padding: 12px;
    opacity: 100;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.35s, 0.35s;
    transition-timing-function: ease-out, ease-out;
    height: 100px;
    margin-bottom: 0;
    width: 300px;
    flex-grow: 1;
}

.notification-info {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.notification-warning {
    -unity-background-image-tint-color: rgb(255, 210, 120);
}

.notification-achievement {
    -unity-background-image-tint-color: rgb(255, 235, 150);
}

.notification-enter {
    opacity: 1;
    translate: 0 0;
}

.notification-exit {
    opacity: 0;
    translate: 0 0;
}

.notification-icon {
    flex-grow: 1;
    max-width: 100%;
    max-height: 100%;
    margin-left: 8px;
    margin-top: 8px;
    margin-bottom: 8px;
    margin-right: 3px;
    justify-content: center;
    align-self: auto;
    align-content: center;
    align-items: center;
    -unity-background-scale-mode: scale-to-fit;
    overflow: hidden;
}

.notification-label {
    max-width: 100%;
    max-height: 100%;
    width: 71%;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-right: 3px;
    padding-left: 3px;
    justify-content: flex-start;
    align-content: flex-start;
    -unity-text-align: middle-left;
    font-size: 16px;
    white-space: normal;
    letter-spacing: 0;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    -unity-text-outline-width: 0;
    text-overflow: clip;
}

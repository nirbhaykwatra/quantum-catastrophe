  m_Name: SuperpositionTutorial03
  m_EditorClassIdentifier: Assembly-CSharp::QC.Systems.Tutorials.TutorialSequenceSO
  tutorialId: sup03
  steps:
  - headerText: Superposition Tutorial
    bodyText: 'Awesome! By observing the level, the wall blocking the corridor collapsed
      into a state in which you can pass right through!


      You must use the
      observation button to navigate the rest of this level.'
    illustrationMode: 0
    illustration: {fileID: 0}
    flipbookFrames: []
    flipbookFrameRate: 12
    highlightMode: 0
    highlightTargetId: 
    worldHighlightRadius: 60
    advanceMode: 0
    requiredEventName: 
    timerSeconds: 0
  - headerText: Wall Jump
    bodyText: 'If you jump towards a wall, you will begin slowly sliding down that
      wall.


      If you press the Space key while sliding down a wall, you can
      perform a Wall Jump!'
    illustrationMode: 2
    illustration: {fileID: 0}

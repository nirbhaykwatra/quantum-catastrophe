  m_Name: SuperpositionTutorial02
  m_EditorClassIdentifier: Assembly-CSharp::QC.Systems.Tutorials.TutorialSequenceSO
  tutorialId: sup02
  steps:
  - headerText: Superposition Tutorial
    bodyText: 'Welcome to the Superposition tutorial! This level is all about getting
      across a complicated obstacle course using the power of Quantum Superposition.


      But
      what is Quantum Superposition?'
    illustrationMode: 0
    illustration: {fileID: 0}
    flipbookFrames: []
    flipbookFrameRate: 12
    highlightMode: 0
    highlightTargetId: 
    worldHighlightRadius: 60
    advanceMode: 0
    requiredEventName: 
    timerSeconds: 0
  - headerText: What is Superposition?
    bodyText: "Imagine flipping a coin. \n\nWe know that when the coin lands, it
      can either be in the heads state or in the tails state. But what state is it
      in while it's flipping? \n\nWhile flipping, we can say that the coin is in
      a superposition, meaning that it is both heads and tails at the same time.
      \n\nSimilarly, a quantum system can be in superposition, meaning that it can
      be in multiple states at once."
    illustrationMode: 2
    illustration: {fileID: 0}
    flipbookFrames:

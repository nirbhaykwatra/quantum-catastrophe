  steps:
  - headerText: Quantum Entanglement
    bodyText: 'In this level, you will have to solve a puzzle to escape the room
      by using the concept of Quantum Entanglement!


      But...what is Quantum
      Entanglement?'
    illustrationMode: 0
    illustration: {fileID: 0}
    flipbookFrames: []
    flipbookFrameRate: 12
    highlightMode: 0
    highlightTargetId: 
    worldHighlightRadius: 60
    advanceMode: 0

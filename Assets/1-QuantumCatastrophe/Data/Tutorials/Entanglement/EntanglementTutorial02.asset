  m_Script: {fileID: 11500000, guid: a38ff11e56845d34bb1cbcc759d946a6, type: 3}
  m_Name: EntanglementTutorial02
  m_EditorClassIdentifier: Assembly-CSharp::QC.Systems.Tutorials.TutorialSequenceSO
  tutorialId: ent02
  steps:
  - headerText: Entangling Objects
    bodyText: 'There are some objects here that you can interact with: a green moving
      box, a gray box which you can move by pushing it and a rotating gear.


      You
      can press the "X" button on your keyboard to go into Entanglement Mode!'
    illustrationMode: 1
    illustration: {fileID: 8115644005664255767, guid: 8de39c38c3b208242ab8cb4cebe900a3, type: 3}
    flipbookFrames: []
    flipbookFrameRate: 23.976
    highlightMode: 0
    highlightTargetId: 
    worldHighlightRadius: 60
    advanceMode: 0
    requiredEventName: entanglementModeToggled
    timerSeconds: 0
  - headerText: Entangling Objects
    bodyText: 'In entanglement mode, objects which can be entangled are marked by
      red selectors.


      In order to select an object, simply Left Click with
      your mouse hovering over it. The red selector will turn green to indicate that
      that object is selected.


      With an object select, simply select another
      one to entangle them!


      Note: The object you click second will be affected
      by the one you clicked first, not the other way around.'
    illustrationMode: 2
    illustration: {fileID: 0}

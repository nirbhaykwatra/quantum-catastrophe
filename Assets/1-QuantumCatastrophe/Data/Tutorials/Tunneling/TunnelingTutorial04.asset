  m_Script: {fileID: 11500000, guid: a38ff11e56845d34bb1cbcc759d946a6, type: 3}
  m_Name: TunnelingTutorial04
  m_EditorClassIdentifier: Assembly-CSharp::QC.Systems.Tutorials.TutorialSequenceSO
  tutorialId: tun04
  steps:
  - headerText: Chaining Air Dashes
    bodyText: 'A very interesting thing happens when you pass through energy barriers:
      you get a small burst of energy when you come out of the other side.


      This
      allows you to dash directly from one barrier to the next, building up momentum
      as you go.


      This can help you reach places you would not be able to
      with just the normal dash!'
    illustrationMode: 2
    illustration: {fileID: 0}
